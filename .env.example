# ==============================================================================
# CREWBOARD — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Update values as needed for your local environment.
# 3. NEVER commit the actual '.env' file containing real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=crewboard_user
POSTGRES_PASSWORD=crewboard_secure_password
POSTGRES_DB=crewboard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database URL (Used by FastAPI & Alembic)
# Format: postgresql+psycopg2://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB>
DATABASE_URL=postgresql+psycopg2://crewboard_user:crewboard_secure_password@localhost:5432/crewboard

# ------------------------------------------------------------------------------
# 2. Backend API & Security Configuration (FastAPI)
# ------------------------------------------------------------------------------
# In production, generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development

# Server port binding
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 3. Frontend Client Configuration (Vite + React)
# ------------------------------------------------------------------------------
# Base URL for API calls from browser
VITE_API_URL=http://localhost:8000/api
FRONTEND_PORT=5173

