# ==============================================================================
# CREWBOARD — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Update values as needed for your local environment.
# 3. NEVER commit the actual '.env' file containing real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=crewboard_user
POSTGRES_PASSWORD=crewboard_secure_password
POSTGRES_DB=crewboard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database URL (Used by FastAPI & Alembic)
# Format: postgresql+psycopg2://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB>
DATABASE_URL=postgresql+psycopg2://crewboard_user:crewboard_secure_password@localhost:5432/crewboard

# ------------------------------------------------------------------------------
# 2. Backend API & Security Configuration (FastAPI)
# ------------------------------------------------------------------------------
# In production, generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development

# Server port binding
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Persistent File Upload Storage (Defaults to /app/uploads in Docker or ./uploads locally)
UPLOAD_DIR=/app/uploads

# ------------------------------------------------------------------------------
# 3. Frontend Client Configuration (Vite + React)
# ------------------------------------------------------------------------------
# Base URL for API calls from browser
VITE_API_URL=http://localhost:8000/api
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# 4. Production Domain & Automated HTTPS (Caddy Edge Gateway)
# ------------------------------------------------------------------------------
# Fully qualified domain name pointing to the server's public IP (used in docker-compose.prod.yml)
DOMAIN=crewboard.yourdomain.edu
# Notification email for Let's Encrypt TLS certificate lifecycle & renewal
TLS_EMAIL=admin@yourdomain.edu

# ------------------------------------------------------------------------------
# 5. Production Container Image Overrides (Optional — defaults to latest on GHCR)
# ------------------------------------------------------------------------------
# BACKEND_IMAGE=ghcr.io/sanjay-h-08/crewboard-backend:v1.0.0
# FRONTEND_IMAGE=ghcr.io/sanjay-h-08/crewboard-frontend:v1.0.0
